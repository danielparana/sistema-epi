generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  epiHistories EpiHistory[]
}

model Employee {
  id         Int        @id @default(autoincrement())
  nome       String
  cpf        String     @unique
  cargo      String
  createdAt  DateTime   @default(now())
  deliveries Delivery[]
}

model Epi {
  id                Int          @id @default(autoincrement())
  nome              String
  lote              String       @unique
  descricao         String?
  quantidade        Int
  initialQuantidade Int
  vencimento        DateTime?
  createdAt         DateTime     @default(now())
  deliveries        Delivery[]
  epiHistories      EpiHistory[]
}

model EpiHistory {
  id                 Int      @id @default(autoincrement())
  epiId              Int
  userId             Int
  previousNome       String?
  previousLote       String
  previousDescricao  String?
  previousQuantidade Int
  createdAt          DateTime @default(now())
  epi                Epi      @relation(fields: [epiId], references: [id])
  user               User     @relation(fields: [userId], references: [id])
}

model Delivery {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  epiId       Int
  quantidade  Int
  dataEntrega DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id])
  epi         Epi      @relation(fields: [epiId], references: [id])
}
