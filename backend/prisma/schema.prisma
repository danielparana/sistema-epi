generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  employeeId   Int?         @unique
  role         String?      @default("FUNCIONARIO")
  epiHistories EpiHistory[]
  employee     Employee?    @relation(fields: [employeeId], references: [id])
}

model Employee {
  id         Int        @id @default(autoincrement())
  nome       String
  cpf        String     @unique
  cargo      String
  createdAt  DateTime   @default(now())
  active     Boolean    @default(true)

  sectorId   Int?
  sector     Sector?    @relation(fields: [sectorId], references: [id])

  deliveries Delivery[]
  user       User?
}

model Epi {
  id                Int          @id @default(autoincrement())
  nome              String
  lote              String       @unique
  descricao         String?
  quantidade        Int
  initialQuantidade Int
  vencimento        DateTime?
  createdAt         DateTime     @default(now())
  deliveries        Delivery[]
  epiHistories      EpiHistory[]
  emailAlerts       EmailAlert[]
}

model EpiHistory {
  id                 Int      @id @default(autoincrement())
  epiId              Int
  userId             Int
  previousNome       String?
  previousLote       String
  previousDescricao  String?
  previousQuantidade Int
  createdAt          DateTime @default(now())
  epi                Epi      @relation(fields: [epiId], references: [id])
  user               User     @relation(fields: [userId], references: [id])
}

model Delivery {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  epiId       Int
  quantidade  Int
  dataEntrega DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id])
  epi         Epi      @relation(fields: [epiId], references: [id])
}

model Sector {
  id           Int          @id @default(autoincrement())
  nome         String       @unique

  employees    Employee[]
  responsible  Responsible?
}

model Responsible {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique

  sectorId  Int      @unique
  sector    Sector   @relation(fields: [sectorId], references: [id])
}

model EmailAlert {
  id           Int      @id @default(autoincrement())
  epiId        Int
  diasAlerta   Int
  enviadoEm    DateTime @default(now())

  epi          Epi      @relation(fields: [epiId], references: [id])

  @@unique([epiId, diasAlerta])
}